# Environment files — NEVER commit credentials
.env
.env.*
!.env.example

# Build output
dist/
build/

# Dependencies
node_modules/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage / test artifacts
coverage/
.nyc_output/

# Prisma generated client (regenerated on postinstall)
node_modules/.prisma/

# TypeScript incremental build info
*.tsbuildinfo

# Editor & OS artifacts
.DS_Store
.idea/
.vscode/
*.swp
*.swo
Thumbs.db

# Docker override files that may contain secrets
docker-compose.override.yml

# Prisma compiled config artifacts
prisma.config.js
prisma.config.js.map
prisma.config.d.ts


# Compiled scratch/util artifacts (não versionar)
check-db.*
scratch-check.*
.vercel

# Saídas geradas por scripts de scratch — dados, não fonte. Poluíam o histórico
# (quality-report.json deu 437 linhas de churn em 2026-08-01). Limpeza 2026-08-01.
scratch/quality-report.json
scratch/test-response.json

# Saída do tsc para scripts avulsos: o .js as vezes E a fonte (jest.config.js,
# clear-cache.js), mas .d.ts e .js.map nunca sao — sao sempre gerados.
# Limpeza 2026-07-29: 20 desses estavam versionados.
*.d.ts
!src/**/*.d.ts
*.js.map
*.ts.bak

# Compose / root-level secrets — NEVER commit
.env
.env.*
!.env.example
!.env.docker.example

# OS / editor
.DS_Store
.idea/
.vscode/

# Build / runtime artifacts
node_modules/
dist/
build/
.next/
coverage/
*.log
valhalla_data/
.vercel
# cache do eslint (--cache), gerado pelo verificador diário
.eslintcache

# Python
.venv/
__pycache__/
*.pyc

# Antigravity brains migrados (2026-09-15): textual versionado, binário só local
# Screenshots são referência histórica sem valor em diff/merge; ficam no disco
# mas fora do repo. ~88MB brutos → ~10MB versionados.
audit/brains-antigravity/**/screenshots/
audit/brains-antigravity/**/*.png
audit/brains-antigravity/**/*.webp
audit/brains-antigravity/**/*.jpg
audit/brains-antigravity/**/*.jpeg
audit/brains-antigravity/**/*.gif

# Acervo clássico de domínio público — os EPUBs/TXTs baixados do Project
# Gutenberg são fonte que já foi ingerida no UserEmbedding (banco Supabase);
# o banco é a fonte de verdade, não o disco. Mantém aqui como cache local
# para re-ingestão eventual, mas fora do repo (200+ MB).
acervo-traduzido/*.epub
acervo-traduzido/*.txt
acervo-traduzido/*.pdf

# Scratch/diagnóstico do backend — scripts one-shot que exercitam o banco
# de produção ou geram artefatos temporários. Não são código do produto.
backend/scratch/*.json
backend/scratch/ingestion-checkpoint.json

# Local AI-assistant conversation stores: contain pasted credentials. Never commit.
audit/brains-antigravity/**/conversation.db
